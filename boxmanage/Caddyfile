{
	servers :8090 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

:8090 {
	tls {$TLS_CERT} {$TLS_KEY}

	# SSE stream dálkového skeneru nesmí být gzipovaný (komprese by zdržovala
	# živé události) — vyloučíme ho pojmenovaným matcherem.
	@notstream not path /api/remote/*/*
	encode @notstream gzip

	reverse_proxy 127.0.0.1:8091 {
		flush_interval -1
	}
}
